# Copie para .env e ajuste. Nunca versione o .env.

# ---------- Aplicação ----------
APP_ENV=production
# Gere com: openssl rand -base64 48
SESSION_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
SESSION_TTL=8h
# true em produção (exige HTTPS). Para testar em http://localhost, o navegador aceita cookies Secure.
COOKIE_SECURE=true
# Endereço público do site, usado nos links de convite enviados por e-mail.
PUBLIC_BASE_URL=http://localhost:8080
# Porta publicada pelo Nginx no host.
HTTP_PORT=8080
LOG_LEVEL=info
# Só necessário se o frontend for servido em outra origem (ex.: Vite em dev).
ALLOWED_ORIGINS=

# ---------- Limites ----------
LOGIN_RATE_PER_MINUTE=5
PUBLIC_RATE_PER_MINUTE=10
MAX_MESSAGES_PER_GUEST=5

# ---------- Primeiro administrador (bootstrap) ----------
# Criado apenas se ainda não existir nenhum administrador. Depois do primeiro
# start, remova ADMIN_PASSWORD deste arquivo.
ADMIN_NAME=Sofia
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-esta-senha-123

# ---------- Evento (entregue só pelo link pessoal do convite) ----------
EVENT_DATE_LABEL=23 de Janeiro de 2027
EVENT_TIME=11h00
EVENT_ADDRESS_LINE1=Av Saranhema, 1727
EVENT_ADDRESS_LINE2=Guarani, Belo Horizonte - MG
EVENT_MAPS_QUERY=Av Saranhema 1727 Guarani Belo Horizonte MG
EVENT_SIGNATURE=Sofia e João

# ---------- E-mail do convite (opcional) ----------
# Sem SMTP_HOST, nada é enviado e o link do convite aparece no painel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Sofia e João <convite@example.com>

# ---------- Pix (opcional, embutido no build do frontend) ----------
VITE_PIX_KEY=
# Caminho de uma imagem em frontend/public, ex.: /images/pix-qr.png
VITE_PIX_QR_IMAGE=
